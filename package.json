{
  "name": "streamdeck-monitor-switch",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck plugin for Windows: switch monitor layouts with one key (short press / double press / hold).",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/plugin.js --bundle --platform=node --target=node20 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=com.monitorswitch.sdPlugin/bin/plugin.js",
    "pack": "npm run build && node tools/pack.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
